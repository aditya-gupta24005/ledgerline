<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.ledgerline</groupId>
    <artifactId>ledgerline-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ledgerline</name>
    <description>Event-driven trading and post-trade platform</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <modules>
        <module>ledgerline-events</module>
        <module>ledgerline-security</module>
        <module>matching-engine</module>
        <module>order-service</module>
        <module>settlement-service</module>
        <module>risk-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.ledgerline</groupId>
                <artifactId>ledgerline-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.ledgerline</groupId>
                <artifactId>matching-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.ledgerline</groupId>
                <artifactId>ledgerline-security</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
